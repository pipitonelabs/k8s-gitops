---
# Bare-metal nodes (m0, m1, m2): Intel iGPU, two bonded igc NICs, 20 CPU threads.
# The schematic ID is computed from talos/schematics/baremetal.yaml.j2 at render time (just talos schematic-id).
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/{{ ENV.SCHEMATIC }}:v1.14.5
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  vm.nr_hugepages: "1024"                  # PostgreSQL
---
apiVersion: v1alpha1
kind: SysfsConfig
params:
  {% for i in range(0, 20) %}
  devices.system.cpu.cpu{{ i }}.cpufreq.energy_performance_preference: balance_power
  {% endfor %}
---
# The two 2.5G igc ports get the aliases net0 and net1 (in hardware-address order). The SFP+ ports are i40e, so
# they are not matched. An alias does not rename the interface.
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net%d
selector:
  match: link.driver == "igc"
---
# bond0 (LACP over net0 and net1) with VLANs 20, 30 and 70 (br70). The VIP is in controlplane.yaml.j2.
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
  - net1
bondMode: 802.3ad
lacpRate: slow
miimon: 100
xmitHashPolicy: layer3+4
mtu: 1500
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.20
vlanID: 20
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.30
vlanID: 30
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.70
vlanID: 70
parent: bond0
mtu: 1500
---
# Layer 2 bridge onto the servers VLAN for KubeVirt VMs (Multus bridge CNI). No address on the node.
apiVersion: v1alpha1
kind: BridgeConfig
name: br70
links:
  - bond0.70
stp:
  enabled: false
mtu: 1500
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.kubernetes.io/gpu: "true"
---
# bond0's igc ports default to 256 RX descriptors, which overflow on Ceph traffic bursts.
apiVersion: v1alpha1
kind: EthernetConfig
name: enp87s0
rings:
  rx: 4096
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp89s0
rings:
  rx: 4096
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp2s0f0np0
rings:
  rx: 8160
  tx: 8160
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp2s0f1np1
rings:
  rx: 8160
  tx: 8160
