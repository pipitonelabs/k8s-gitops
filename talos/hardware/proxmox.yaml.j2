---
# Proxmox VMs created by github.com/pipitonelabs/talos-vm-workers (Talos nocloud image).
# The NIC is eth0 and gets its address, gateway and DNS from the cloud-init drive, so no link is
# configured here. The VM has a virtual i6300esb watchdog, so the shared WatchdogTimerConfig works.
#
# The installer must stay on the nocloud platform and the VM schematic, or an upgrade would drop the
# guest agent and stop reading the cloud-init drive. The schematic ID is computed from
# talos/schematics/proxmox.yaml.j2 at render time (just talos schematic-id proxmox).
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  # renovate: datasource=docker depName=ghcr.io/siderolabs/installer
  image: factory.talos.dev/nocloud-installer/{{ ENV.SCHEMATIC }}:v1.14.0
# The image is already installed on the VM's only disk (scsi0), so this is only read on an upgrade.
provisioning:
  diskSelector:
    match: disk.dev_path == "/dev/sda"
  wipe: false
