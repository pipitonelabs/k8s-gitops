---
machine:
  type: controlplane
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.serial == "24514D121897"
  wipe: false
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: m2.k8s.internal
---
# bond0 takes the MAC of enp2s0f0np0 (first SFP+ port); the DHCP reservation points at it.
apiVersion: v1alpha1
kind: BondConfig
name: bond0
hardwareAddr: 58:47:ca:7b:f3:ca
