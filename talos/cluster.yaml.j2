---
# Shared by every node. Layered with hardware/<class>.yaml.j2, <role>.yaml.j2 and
# nodes/<class>/<ip>.yaml.j2 by `talosctl machineconfig patch` (see talos/mod.just: render-config).
# Nothing in this file may depend on the kind of machine; that belongs in hardware/.
version: v1alpha1
machine:
  ca:
    crt: op://Kubernetes/talos/MACHINE_CA_CRT
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  # Kept in the legacy v1alpha1 document: the typed KubeletConfig has no extraMounts (Talos 1.14), and the
  # two cannot be combined. The node IP is in KubeNodeConfig below.
  kubelet:
    # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
    image: ghcr.io/siderolabs/kubelet:v1.37.1
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      allowedUnsafeSysctls:
        - net.ipv4.ip_forward
      featureGates:
        ImageVolume: true
        ResourceHealthStatus: true
      imageGCHighThresholdPercent: 60
      imageGCLowThresholdPercent: 50
      imageMaximumGCAge: 168h
      serializeImagePulls: false
    extraMounts:
      - destination: /var/mnt/extra
        type: bind
        source: /var/mnt/extra
        options: ["bind", "rshared", "rw"]
  token: op://Kubernetes/talos/MACHINE_TOKEN
cluster:
  ca:
    crt: op://Kubernetes/talos/CLUSTER_CA_CRT
  clusterName: k8s
  controlPlane:
    endpoint: https://k8s.internal:6443
  token: op://Kubernetes/talos/CLUSTER_TOKEN
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
    - time.cloudflare.com
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: op://Kubernetes/talos/CLUSTER_ID
clusterSecret: op://Kubernetes/talos/CLUSTER_SECRET
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_watches: "1048576"   # Watchdog
  fs.inotify.max_user_instances: "8192"    # Watchdog
  net.core.default_qdisc: fq               # 2.5Gb/s
  net.core.rmem_max: "16777216"            # 2.5Gb/s | Cloudflared / QUIC
  net.core.wmem_max: "16777216"            # 2.5Gb/s | Cloudflared / QUIC
  net.ipv4.tcp_congestion_control: bbr     # 2.5Gb/s
  net.ipv4.tcp_fastopen: "3"               # Send and accept data in the opening SYN packet
  net.ipv4.tcp_mtu_probing: "1"            # 2.5Gb/s
  net.ipv4.tcp_rmem: 4096 87380 8388608    # Optimized for 2.5Gb
  net.ipv4.tcp_wmem: 4096 65536 8388608    # Optimized for 2.5Gb
  net.ipv4.tcp_window_scaling: "1"         # 2.5Gb/s
  sunrpc.tcp_slot_table_entries: "64"      # 2.5Gb/s | NFS
  sunrpc.tcp_max_slot_table_entries: "64"  # 2.5Gb/s | NFS
  user.max_user_namespaces: "11255"        # User Namespaces
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.1
  hard=True
  nconnect=8
  noatime=True
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    cdi_spec_dirs = ["/var/cdi/static", "/var/cdi/dynamic"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: OOMConfig
triggerExpression: "false"
cgroupRankingExpression: "0.0"
sampleInterval: "5s"
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
# No KubeFlannelCNIConfig anywhere means no CNI: Cilium is installed by Flux/bootstrap.
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.244.0.0/16
serviceSubnets:
  - 10.245.0.0/16
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.10.0/24
labels:
  topology.kubernetes.io/region: k8s
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 192.168.10.1
searchDomains:
  disableDefault: true
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false
  resolveMemberNames: true
