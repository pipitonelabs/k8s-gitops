---
# bond0 (LACP over the two igc NICs) with VLANs 20 and 30. The VIP is in controlplane.yaml.j2.
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - enp87s0
  - enp89s0
bondMode: 802.3ad
lacpRate: slow
miimon: 1000
xmitHashPolicy: layer3+4
mtu: 1500
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.20
vlanID: 20
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.30
vlanID: 30
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp2s0f0np0
rings:
  rx: 8160
  tx: 8160
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp2s0f1np1
rings:
  rx: 8160
  tx: 8160
